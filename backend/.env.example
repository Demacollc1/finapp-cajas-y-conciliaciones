# === Aplicación ===
APP_NAME=FinancePro API
ENVIRONMENT=development
API_PREFIX=/api

# === Base de datos ===
# SQLite (por defecto, portable):
DATABASE_URL=sqlite:///./financepro.db
# PostgreSQL (producción):
# DATABASE_URL=postgresql+psycopg://finapp:finapp@localhost:5432/finapp

# === CORS (orígenes del front-end, separados por coma en JSON) ===
# CORS_ORIGINS=["http://localhost:5500","https://tu-front.com"]

# === Semilla de datos de demostración al arrancar ===
SEED_ON_STARTUP=true

# === Firma de tokens QR de traspaso de custodia ===
QR_SECRET=cambia-esta-clave-en-produccion

# === Integración Tableau (ventas del sistema) ===
# Si se dejan vacíos, la API opera en modo simulado.
# TABLEAU_BASE_URL=https://tu-servidor-tableau
# TABLEAU_TOKEN=xxxxx
# TABLEAU_SITE_ID=xxxxx

# === Integración ERP (asiento contable) ===
# ERP_BASE_URL=https://tu-erp/api
# ERP_TOKEN=xxxxx
ERP_CUENTA_CAJA=1.1.01.001
ERP_CUENTA_BANCOS=1.1.02.001
ERP_CUENTA_POSFECHADOS=1.1.03.005
